# ── Google AI Studio (for Fix Grammar / Summarize / Generate Ideas) ──────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Upstash Redis (for global live content sync) ──────────────────────────────
